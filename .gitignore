# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# compiled backend output
/backend/dist/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# foundry / hardhat artifacts (reinstallable, and cache/ may hold sensitive values)
/contracts/cache/
/contracts/out/
/contracts/lib/
anvil.log
/broadcast/*.json
